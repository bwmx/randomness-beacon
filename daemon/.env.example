# Required HTTP(S) URL, without credentials/query/fragment. LocalNet example shown.
ALGOD_SERVER=http://localhost
# Optional override, 1–65535; omit or leave empty to preserve a port in ALGOD_SERVER.
ALGOD_PORT=4001
# Omit or leave empty for tokenless endpoints. No Indexer or KMD settings are used.
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Positive uint64 beacon app ID to serve (1–18446744073709551615)
BEACON_APP_ID=
# 25-word mnemonic of a funded relayer account (legacy variable name; no manager role needed)
MANAGER_MNEMONIC=
# Base64 64-byte VRF secret key: seed and public-key halves must match (npm run generate-keypair).
# Not needed (and ignored) with ROLE=keeper.
VRF_PRIVATE_KEY=

# Optional
# ROLE=both            # watcher (submits proofs) | keeper (fulfills requests, no VRF key) | both
# LOG_LEVEL=info       # trace | debug | info | warn | error | fatal
