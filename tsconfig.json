{
  "compilerOptions": {
    "target": "ES2020",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    // Not nodenext: @algorandfoundation/algorand-typescript ships ESM .d.ts with extensionless re-exports, which only resolve under bundler.
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  // ts-node (local TS 5.x) runs the deploy scripts as CommonJS: they use __dirname and import() extensionless paths.
  "ts-node": {
    "compilerOptions": { "module": "commonjs", "moduleResolution": "node10" }
  },
  "include": ["smart_contracts/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
